# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Model ids: check the current list at https://docs.claude.com before setting.
# MODEL_READ  = vision reading + reconciling (use the most capable model you can afford)
# MODEL_FAST  = cheap tasks (report wording later)
MODEL_READ=
MODEL_FAST=

# Thinking depth for reading: low | medium | high | xhigh | max
READ_EFFORT=high

# Server-side refusal fallback: "default" (recommended) or "off"
LLM_FALLBACKS=default
